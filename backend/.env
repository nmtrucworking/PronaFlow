# =================================================================
# PRONAFLOW - ENVIRONMENT CONFIGURATION
# =================================================================

# --- APP CONFIGURATION ---
APP_NAME="PronaFlow Backend"
APP_ENV=development
DEBUG=True
API_V1_STR="/api/v1"

# --- SECURITY & AUTHENTICATION ---
# Token được ký bằng thuật toán HS256 hoặc RS256
# Sử dụng 'openssl rand -hex 32' để tạo secret key mới
SECRET_KEY="ahd9O&H*AS^DU$IHASDOP&(#BHUSDFBOAY97hafujha935hf0a"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# --- POSTGRESQL DATABASE ---
# Vai trò: Lưu trữ dữ liệu quan hệ và JSONB
# Sử dụng driver asyncpg cho SQLAlchemy AsyncIO
POSTGRES_USER=postgres
POSTGRES_PASSWORD="ADAd242@$udgu978d&A&%"
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pronaflow
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- REDIS CACHING & MESSAGING ---
# Vai trò: Session, User Profile Caching và Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- AI SERVICE INTEGRATION ---
# Main Backend giao tiếp qua Adapter Pattern (HTTP/REST hoặc MQ)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30.0

# --- FILE STORAGE ---
UPLOAD_DIR="../storage/uploads"
MAX_UPLOAD_SIZE=5242880  # 5MB

# --- CORS SETTINGS ---
# Cho phép Frontend React truy cập (Mặc định Vite chạy port 5173)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]